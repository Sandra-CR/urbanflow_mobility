# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@host:5432/database
RUN_DB_TESTS=false

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# IDF Mobilités
IDFM_API_KEY=replace-with-your-idfm-api-key
IDFM_API_BASE_URL=https://prim.iledefrance-mobilites.fr/marketplace/v2/navitia

# Street routing fallback (trajets à pied et à vélo)
ROUTING_API_BASE_URL=https://router.project-osrm.org

# GBFS Vélib
VELIB_API_BASE_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole
